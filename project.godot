; Pixel Spaces Manager - configuración del proyecto
config_version=5

[application]

config/name="Pixel Spaces Manager"
config/version="1.6.0"
config/description="Room Decorator & Delivery - assets Pixel Spaces de Netherzapdos"
run/main_scene="res://scenes/ui/LoadingScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

GameLog="*res://scripts/autoload/GameLog.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
Database="*res://scripts/autoload/Database.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/custom="res://assets/ui/pixel_theme.tres"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="interactables"
2d_physics/layer_4="hazards"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.105, 0.09, 0.14, 1)
